{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./config/oxlint/react.json"],
  "env": {
    "builtin": true,
    "node": true,
    "browser": true,
    "serviceworker": true
  },
  "settings": {
    "react": {
      "version": "18.3.1"
    }
  },
  "ignorePatterns": ["**/node_modules/**", "**/.turbo/**", "**/.next/**", "**/dist/**", "**/build/**", "**/public/**", "**/static/**", "**/coverage/**", "_tmp/**", "_works/**", ".claude/**"]
}
